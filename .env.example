# ---------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Supabase)
# ---------------------------------------------------------------------------

# Option A: Supabase (Production & Cloud Hosting)
# 1. Direct connection (Port 5432 - recommended for running `npx prisma db push`):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
#
# 2. Transaction Pooler (Port 6543 - recommended for serverless runtimes like Vercel):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Option B: Local PostgreSQL (via Docker or local install)
# Docker command: docker run -d --name prabodha-pg -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=prabodha postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prabodha"

# ---------------------------------------------------------------------------
# Authentication Secrets
# ---------------------------------------------------------------------------
JWT_SECRET="change-me-to-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"
