# PostgreSQL (required — run via Docker or install locally)
# Docker: docker run -d --name prabodha-pg -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=prabodha postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prabodha"

# Legacy SQLite option (not recommended — no enum or type support)
# DATABASE_URL="file:./dev.db"

JWT_SECRET="change-me-to-a-random-secret"
JWT_EXPIRES_IN="7d"
